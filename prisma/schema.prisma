// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id       Int    @id @default(autoincrement())
  merchant_id Int
  details  String
  token_id Int
  token    Token  @relation(fields: [token_id], references: [id])
  merchant Merchant @relation(fields: [merchant_id], references: [id])
  amount   Int
  status String
  paymentTxHash String
}

model Merchant {
  id     Int     @id @default(autoincrement())
  name   String
  Wallet Wallet?

  Payment Payment[]

  Invoice Invoice[]
}

model Payment {
  id          Int    @id @default(autoincrement())
  txHash      String
  merchant_id Int

  merchant Merchant @relation(fields: [merchant_id], references: [id])
}

model Token {
  id      Int    @id @default(autoincrement())
  name    String
  address String

  // Invoice Invoice[] @relation(name: "acceptedTokens")

  // Invoice Invoice?

  Invoice Invoice[]
}

model Wallet {
  id         Int       @id @default(autoincrement())
  publicKey  String
  privateKey String
  owner_id   Int       @unique
  owner      Merchant? @relation(fields: [owner_id], references: [id])
}
